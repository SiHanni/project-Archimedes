# Copy to .env and adjust for local Docker Compose

# MySQL (compose service name: mysql)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=archimedes
MYSQL_PASSWORD=archimedes
MYSQL_DATABASE=archimedes

# Redis
REDIS_URL=redis://redis:6379

# S3-compatible (MinIO in compose)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=archimedes-uploads
S3_REGION=us-east-1
# For browser / host-machine URLs (optional; API uses internal endpoint above)
S3_PUBLIC_ENDPOINT=http://localhost:29000

# Worker / API
ALGORITHM_VERSION=archimedes-g1-v0.1.0-scaffold
QUEUE_NAME=archimedes:queue
DEBUG_SAVE_MASKS=0
WORKER_OUTPUT_DIR=/output
# 품질 게이트: 라플라시안 분산 하한(낮을수록 흐린 사진 허용). 기본 6.0 — 엄격히 하려면 20~40대로 올리기.
ARCHIMEDES_BLUR_THRESHOLD=6

# OpenTelemetry (Phase 7 stub — set endpoint when collector exists)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Worker v2 백엔드 (상세: .cursor/rules/archimedes-v2-single-photo.mdc §2)
# 기본은 모델 없이 도는 stub/heuristic. ONNX 는 `pip install -e ".[onnx]"` 후 사용.
ARCHIMEDES_DETECTOR_BACKEND=stub
ARCHIMEDES_SEGMENTATION_BACKEND=heuristic
ARCHIMEDES_DEPTH_BACKEND=stub
ARCHIMEDES_ONNX_MODEL_DIR=/models
# 깊이 모델 출력 성격 — 틀리면 스케일 복원이 통째로 어긋난다
ARCHIMEDES_DEPTH_OUTPUT_KIND=affine_invariant
ARCHIMEDES_DEPTH_OUTPUT_INVERSE=0
# 1이면 카드(메트릭 앵커) 없는 job 거절
ARCHIMEDES_REQUIRE_ANCHOR=0
# 다뷰 모드 전용
ARCHIMEDES_USE_VOXEL_CARVE=1
# 카드 미검출 시 가짜 사각형 가정 — 스케일이 날조되므로 데모 외 사용 금지
ARCHIMEDES_ALLOW_CARD_FALLBACK=0
# 카드 면 위 세그 감지 시 작업 거절(기본 1). 데모만 카드 위 허용 시 0
ARCHIMEDES_REJECT_ON_CARD_INNER=1
# 추정 무게(g)가 이 값과 제품별 상한 중 더 작은 값을 넘으면 비현실적 → 웹에서 무게 숫자 숨김
ARCHIMEDES_SANITY_MAX_MASS_G=2500
